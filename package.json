{
  "name": "happow",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @happow/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc -p scripts/tsconfig.json",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/migrate.ts --reset && tsx scripts/seed.ts",
    "test:db": "vitest run --root scripts --no-file-parallelism",
    "ingest": "tsx packages/ingest/src/cli.ts",
    "deploy": "pnpm --filter @happow/web build && wrangler deploy"
  },
  "devDependencies": {
    "@happow/core": "workspace:*",
    "@happow/extract": "workspace:*",
    "@happow/ingest": "workspace:*",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.15.0",
    "dotenv": "^16.4.7",
    "pg": "^8.16.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "4.151.3"
  }
}
