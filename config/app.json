{
  "defaultRegion": "wroclaw",
  "languages": ["pl", "en"],
  "fallbackLanguage": "en",
  "radius": {
    "minM": 100,
    "maxM": 25000,
    "defaultM": 500
  },
  "walkingSpeedMPerMin": 80,
  "h3": {
    "eventResolution": 9,
    "densityResolution": 8
  },
  "density": {
    "searchRadiusM": 5000,
    "hotspotMinEvents": 3,
    "maxChevrons": 6
  },
  "refresh": {
    "dataMinutes": 5,
    "locationMinutes": 5,
    "moveThresholdM": 100,
    "areaGridDeg": 0.05,
    "areaRadiiM": [5000, 10000, 25000],
    "areaHours": 24,
    "areaMaxEvents": 1000
  },
  "navigation": {
    "routing": {
      "provider": "openrouteservice",
      "endpoint": "https://api.heigit.org/openrouteservice/v2/directions/foot-walking/geojson",
      "secret": "ORS_API_KEY",
      "attribution": "© openrouteservice by HeiGIT | Data from OpenStreetMap"
    },
    "routesPerHourPerClient": 30,
    "maxRouteKm": 30,
    "arriveM": 40,
    "offRouteM": 50,
    "rerouteMinSeconds": 30,
    "maxReroutes": 10,
    "maxMinutes": 45,
    "eventRefreshSeconds": 60
  },
  "timeWindows": [
    {
      "id": "now",
      "hours": 0
    },
    {
      "id": "2h",
      "hours": 2
    },
    {
      "id": "6h",
      "hours": 6
    },
    {
      "id": "today",
      "endOfDay": true
    }
  ],
  "defaultTimeWindow": "today",
  "dedup": {
    "startToleranceMin": 30,
    "titleSimilarity": 0.5,
    "h3Ring": 1
  },
  "ingest": {
    "descriptionMaxChars": 600,
    "lookbackHours": 8,
    "lookaheadHours": 48,
    "userAgent": "Happow/0.4 (+https://happow.krasnoroda.workers.dev/crawler)",
    "missedRunsToFlag": 2,
    "dispatch": {
      "repo": "PriamSinbob/happow",
      "workflow": "ingest.yml",
      "ref": "main",
      "tokenSecret": "GITHUB_DISPATCH_TOKEN",
      "skippedBackoffHours": 24,
      "failedRetryMinutes": 60,
      "runningTimeoutMinutes": 40
    }
  },
  "geocoding": {
    "provider": "nominatim",
    "endpoint": "https://nominatim.openstreetmap.org/search",
    "minIntervalMs": 1100,
    "cacheDays": 30
  },
  "extraction": {
    "provider": "anthropic",
    "model": "claude-haiku-5-5",
    "effort": "low",
    "secret": "ANTHROPIC_API_KEY",
    "maxInputChars": 12000,
    "maxTokens": 16000,
    "minConfidence": 0.7,
    "maxPageBytes": 3000000,
    "autofillLlmPerDay": 300,
    "schemaTypeMap": {
      "musicevent": "music",
      "danceevent": "music",
      "theaterevent": "theatre",
      "comedyevent": "theatre",
      "screeningevent": "cinema",
      "exhibitionevent": "exhibition",
      "visualartsevent": "exhibition",
      "festival": "festival",
      "sportsevent": "sport",
      "childrensevent": "kids",
      "foodevent": "food",
      "saleevent": "market",
      "educationevent": "talk",
      "literaryevent": "talk",
      "businessevent": "talk",
      "socialevent": "happening"
    }
  },
  "submissions": {
    "publishBeforeModeration": true,
    "flagThreshold": 1,
    "autofill": false,
    "maxPerDevicePerDay": 10,
    "autofillPerHourPerClient": 30,
    "reportsPerDayPerDevice": 20,
    "maxDescriptionChars": 600
  },
  "confidence": {
    "trust": { "api": 1, "crawled": 0.95, "community": 0.85 },
    "missingEnd": 0.95,
    "missingVenue": 0.9
  },
  "analytics": {
    "plausibleDomain": null,
    "scriptUrl": "https://plausible.io/js/script.manual.js"
  },
  "legal": {
    "contactEmail": "krasnoroda@gmail.com"
  }
}
