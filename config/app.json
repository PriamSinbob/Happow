{
  "defaultRegion": "wroclaw",
  "languages": ["pl", "en"],
  "fallbackLanguage": "en",
  "radius": {
    "minM": 100,
    "maxM": 25000,
    "defaultM": 500,
    "detentsM": [100, 250, 500, 1000, 2000, 5000]
  },
  "walkingSpeedMPerMin": 80,
  "arrival": {
    "detourFactor": 1.3,
    "openLastEntryMin": 5
  },
  "family": {
    "latestEnd": "21:00"
  },
  "dice": {
    "maxDistanceM": 2000,
    "soonMin": 60,
    "reachMargin": 1.15,
    "fanSize": 5
  },
  "atlas": {
    "resolution": 9,
    "maxAccuracyM": 100,
    "sessionGapMin": 30,
    "veilRadiusM": 6000,
    "canvasPx": 512,
    "fadeZoom": { "full": 12.8, "gone": 10.5 },
    "strength": { "open": 0.35, "arrival": 0.85, "repeat": 0.12 },
    "blobsPerCell": 5
  },
  "h3": {
    "eventResolution": 9,
    "densityResolution": 8
  },
  "density": {
    "searchRadiusM": 5000,
    "hotspotMinEvents": 3,
    "maxEdgeDots": 24,
    "deviceCellM": 650
  },
  "refresh": {
    "dataMinutes": 5,
    "locationMinutes": 5,
    "moveThresholdM": 100,
    "areaGridDeg": 0.05,
    "areaRadiiM": [5000, 10000, 25000],
    "areaHours": 24,
    "areaMaxEvents": 1000,
    "longCacheMinutes": 30
  },
  "navigation": {
    "routing": {
      "provider": "openrouteservice",
      "endpoint": "https://api.heigit.org/openrouteservice/v2/directions/foot-walking/geojson",
      "secret": "ORS_API_KEY",
      "attribution": "© openrouteservice by HeiGIT | Data from OpenStreetMap"
    },
    "routesPerHourPerClient": 30,
    "maxRouteKm": 30,
    "arriveM": 40,
    "offRouteM": 50,
    "rerouteMinSeconds": 30,
    "maxReroutes": 10,
    "maxMinutes": 45,
    "eventRefreshSeconds": 60
  },
  "timeWindows": [
    {
      "id": "today",
      "endOfDay": true
    },
    {
      "id": "week",
      "days": 7
    },
    {
      "id": "later",
      "days": 14
    }
  ],
  "timeline": {
    "snapNowMin": 10,
    "stepMin": 5,
    "binMin": 30,
    "carryOverMin": 360
  },
  "defaultTimeWindow": "today",
  "dedup": {
    "startToleranceMin": 30,
    "titleSimilarity": 0.5,
    "h3Ring": 1
  },
  "ingest": {
    "descriptionMaxChars": 600,
    "lookbackHours": 8,
    "lookaheadHours": 360,
    "userAgent": "Happow/0.4 (+https://happow.krasnoroda.workers.dev/crawler)",
    "missedRunsToFlag": 2,
    "dispatch": {
      "repo": "PriamSinbob/happow",
      "workflow": "ingest.yml",
      "ref": "main",
      "tokenSecret": "GITHUB_DISPATCH_TOKEN",
      "skippedBackoffHours": 24,
      "failedRetryMinutes": 60,
      "runningTimeoutMinutes": 40
    }
  },
  "geocoding": {
    "provider": "nominatim",
    "endpoint": "https://nominatim.openstreetmap.org/search",
    "minIntervalMs": 1100,
    "cacheDays": 30
  },
  "extraction": {
    "provider": "anthropic",
    "model": "claude-haiku-5-5",
    "effort": "low",
    "secret": "ANTHROPIC_API_KEY",
    "maxInputChars": 12000,
    "maxTokens": 16000,
    "minConfidence": 0.7,
    "maxPageBytes": 3000000,
    "autofillLlmPerDay": 300,
    "schemaTypeMap": {
      "musicevent": "music",
      "danceevent": "music",
      "theaterevent": "theatre",
      "comedyevent": "theatre",
      "screeningevent": "cinema",
      "exhibitionevent": "exhibition",
      "visualartsevent": "exhibition",
      "festival": "festival",
      "sportsevent": "sport",
      "childrensevent": "kids",
      "foodevent": "food",
      "saleevent": "market",
      "educationevent": "talk",
      "literaryevent": "talk",
      "businessevent": "talk",
      "socialevent": "happening"
    }
  },
  "submissions": {
    "publishBeforeModeration": true,
    "flagThreshold": 1,
    "autofill": false,
    "maxPerDevicePerDay": 10,
    "autofillPerHourPerClient": 30,
    "reportsPerDayPerDevice": 20,
    "maxDescriptionChars": 600
  },
  "confidence": {
    "trust": { "api": 1, "crawled": 0.95, "community": 0.85 },
    "missingEnd": 0.95,
    "missingVenue": 0.9
  },
  "analytics": {
    "plausibleDomain": null,
    "scriptUrl": "https://plausible.io/js/script.manual.js"
  },
  "legal": {
    "contactEmail": "krasnoroda@gmail.com",
    "termsVersion": "2026-10-24-interim"
  },
  "auth": {
    "emailDelivery": "manual",
    "codeRequestsPerHourPerClient": 5,
    "codeRequestsPerDayPerEmail": 3,
    "codeRequestRetentionDays": 7,
    "codeValidHours": 24,
    "userCacheSec": 300,
    "codeEmail": {
      "pl": {
        "subject": "Twój kod do Happow: {code}",
        "body": "Cześć!\n\nTwój kod logowania do Happow: {code}\n\nWpisz go w aplikacji albo otwórz ten link na telefonie, na którym używasz Happow:\n{link}\n\nKod i link działają przez {hours} godz. Jeśli to nie Ty prosisz o kod, zignoruj tę wiadomość.\n\nHappow"
      },
      "en": {
        "subject": "Your Happow code: {code}",
        "body": "Hi!\n\nYour Happow sign-in code: {code}\n\nType it into the app, or open this link on the phone where you use Happow:\n{link}\n\nThe code and the link work for {hours} hours. If you didn't ask for a code, ignore this email.\n\nHappow"
      }
    }
  },
  "premium": {
    "providers": []
  }
}
