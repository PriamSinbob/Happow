{
  "defaultRegion": "wroclaw",
  "languages": ["pl", "en"],
  "fallbackLanguage": "en",
  "radius": {
    "minM": 100,
    "maxM": 25000,
    "defaultM": 500,
    "detentsM": [100, 250, 500, 1000, 2000, 5000]
  },
  "walkingSpeedMPerMin": 80,
  "arrival": {
    "detourFactor": 1.3,
    "openLastEntryMin": 5
  },
  "family": {
    "latestEnd": "21:00"
  },
  "dice": {
    "maxDistanceM": 2000,
    "soonMin": 60,
    "reachMargin": 1.15,
    "fanSize": 5
  },
  "atlas": {
    "resolution": 9,
    "maxAccuracyM": 100,
    "sessionGapMin": 30,
    "veilRadiusM": 6000,
    "canvasPx": 512,
    "fadeZoom": { "full": 12.8, "gone": 10.5 },
    "strength": { "open": 0.35, "arrival": 0.85, "repeat": 0.12 },
    "blobsPerCell": 5
  },
  "h3": {
    "eventResolution": 9,
    "densityResolution": 8
  },
  "density": {
    "searchRadiusM": 5000,
    "hotspotMinEvents": 3,
    "maxEdgeDots": 24,
    "deviceCellM": 650
  },
  "refresh": {
    "dataMinutes": 5,
    "locationMinutes": 5,
    "moveThresholdM": 100,
    "areaGridDeg": 0.05,
    "areaRadiiM": [5000, 10000, 25000],
    "areaHours": 24,
    "areaMaxEvents": 1000,
    "longCacheMinutes": 30
  },
  "navigation": {
    "routing": {
      "provider": "openrouteservice",
      "endpoint": "https://api.heigit.org/openrouteservice/v2/directions/foot-walking/geojson",
      "secret": "ORS_API_KEY",
      "attribution": "© openrouteservice by HeiGIT | Data from OpenStreetMap"
    },
    "routesPerHourPerClient": 30,
    "maxRouteKm": 30,
    "arriveM": 40,
    "offRouteM": 50,
    "rerouteMinSeconds": 30,
    "maxReroutes": 10,
    "maxMinutes": 45,
    "eventRefreshSeconds": 60
  },
  "timeWindows": [
    {
      "id": "today",
      "endOfDay": true
    },
    {
      "id": "later",
      "days": 14
    },
    {
      "id": "future",
      "afterDays": 14,
      "months": 12
    }
  ],
  "timeline": {
    "snapNowMin": 10,
    "stepMin": 5,
    "binMin": 30,
    "carryOverMin": 360
  },
  "defaultTimeWindow": "today",
  "dedup": {
    "startToleranceMin": 30,
    "titleSimilarity": 0.5,
    "h3Ring": 1,
    "radiusM": 200
  },
  "ingest": {
    "descriptionMaxChars": 600,
    "lookbackHours": 8,
    "lookaheadHours": 8760,
    "userAgent": "Happow/0.5 (+{siteUrl}/crawler; {contactEmail})",
    "politeness": {
      "conditionalRequests": true,
      "respectTdm": true,
      "revisitHours": 72,
      "revisitFarDays": 7
    },
    "missedRunsToFlag": 2,
    "dispatch": {
      "repo": "PriamSinbob/happow",
      "workflow": "ingest.yml",
      "ref": "main",
      "tokenSecret": "GITHUB_DISPATCH_TOKEN",
      "skippedBackoffHours": 24,
      "failedRetryMinutes": 360,
      "runningTimeoutMinutes": 70,
      "batchAheadHours": 6
    }
  },
  "geocoding": {
    "provider": "nominatim",
    "endpoint": "https://nominatim.openstreetmap.org/search",
    "minIntervalMs": 1100,
    "cacheDays": 30
  },
  "extraction": {
    "provider": "anthropic",
    "model": "claude-haiku-5-5",
    "effort": "low",
    "secret": "ANTHROPIC_API_KEY",
    "maxInputChars": 12000,
    "maxTokens": 16000,
    "minConfidence": 0.7,
    "maxPageBytes": 3000000,
    "autofillLlmPerDay": 300,
    "photo": {
      "maxBytes": 1500000,
      "maxEdge": 1568,
      "jpegQuality": 0.85
    },
    "schemaTypeMap": {
      "musicevent": "music",
      "danceevent": "music",
      "theaterevent": "theatre",
      "comedyevent": "theatre",
      "screeningevent": "cinema",
      "exhibitionevent": "exhibition",
      "visualartsevent": "exhibition",
      "festival": "festival",
      "sportsevent": "sport",
      "childrensevent": "kids",
      "foodevent": "food",
      "saleevent": "market",
      "educationevent": "talk",
      "literaryevent": "talk",
      "businessevent": "talk",
      "socialevent": "happening"
    }
  },
  "submissions": {
    "publishBeforeModeration": true,
    "flagThreshold": 1,
    "autofill": "account",
    "account": "required",
    "maxPerDevicePerDay": 10,
    "perHourPerAccount": 30,
    "autofillPerHour": 30,
    "reportsPerDayPerDevice": 20,
    "maxDescriptionChars": 600,
    "quickAdd": { "maxAccuracyM": 100, "roundMin": 5 },
    "recurring": { "maxWeeks": 12, "maxOccurrences": 24 }
  },
  "confidence": {
    "trust": { "api": 1, "crawled": 0.95, "community": 0.85 },
    "missingEnd": 0.95,
    "missingVenue": 0.9
  },
  "analytics": {
    "plausibleDomain": null,
    "scriptUrl": "https://plausible.io/js/script.manual.js"
  },
  "osm": {
    "overpassUrls": [
      "https://overpass-api.de/api/interpreter",
      "https://overpass.private.coffee/api/interpreter",
      "https://maps.mail.ru/osm/tools/overpass/api/interpreter"
    ],
    "userAgent": "Happow/0.4"
  },
  "venues": {
    "osmTags": {
      "amenity": [
        "theatre",
        "arts_centre",
        "cinema",
        "nightclub",
        "community_centre",
        "social_centre",
        "library",
        "place_of_worship",
        "music_venue",
        "events_venue",
        "concert_hall",
        "conference_centre"
      ],
      "tourism": ["museum", "gallery"]
    },
    "link": { "radiusM": 150, "minSimilarity": 0.6, "moveSimilarity": 0.8, "minMoveM": 15 },
    "probe": {
      "perRun": 20,
      "recheckDays": 30,
      "eventsPageWords": [
        "wydarzeni",
        "kalendarz",
        "repertuar",
        "program",
        "koncerty",
        "imprezy",
        "events",
        "calendar"
      ]
    },
    "pauseAfterFailures": 3
  },
  "counts": { "maxBatch": 50, "perHourPerDevice": 240 },
  "attendance": {
    "publicMin": 5,
    "buckets": [5, 10, 25],
    "keepAfterEndHours": 24,
    "perHourPerDevice": 120,
    "sharesPerHourPerDevice": 30,
    "lookingMinutes": 30,
    "hereRadiusM": 100
  },
  "agenda": {
    "views": ["all", "plans", "saved", "private"],
    "keepPastDays": 30,
    "keepRemovedDays": 30,
    "maxSaved": 200,
    "maxPerRead": 200,
    "walkRoundMin": 5,
    "leaveStepMin": 15,
    "syncPerHour": 120
  },
  "push": {
    "secret": "VAPID_PRIVATE_KEY",
    "ttlSeconds": 3600,
    "subscribePerHourPerDevice": 20
  },
  "reminders": {
    "leads": ["15", "30", "60", "120", "dayBefore"],
    "defaultLead": "60",
    "dayBeforeAt": "18:00",
    "maxPerDevice": 50,
    "perHourPerDevice": 60,
    "cronMinutes": 15,
    "maxPerTick": 6
  },
  "sharing": {
    "endedNearbyMax": 5,
    "endedLabel": { "pl": "Zakończone", "en": "Ended" }
  },
  "private": {
    "keepAfterEndDays": 30,
    "maxContacts": 500,
    "maxGroups": 20,
    "maxInvitationsPerEvent": 200,
    "perHourPerAccount": 120
  },
  "organiser": {
    "postsPerEventPerDay": 10,
    "checksPerHour": 10,
    "editsPerHour": 60,
    "venueRadiusM": 75,
    "postsCacheSec": 60
  },
  "notices": { "maxAudience": 500, "inline": 3, "maxPerTick": 6 },
  "search": {
    "minSimilarity": 0.3,
    "minWordSimilarity": 0.6,
    "minChars": 2,
    "maxChars": 80,
    "maxResults": 40,
    "perHourPerClient": 300,
    "cacheSeconds": 60,
    "debounceMs": 300
  },
  "follows": {
    "max": 200,
    "matchPerHourPerClient": 30,
    "matchEveryMinutes": 60,
    "nationwide": {
      "enabled": true,
      "sourceId": "ticketmaster",
      "maxAgeHours": 24,
      "perDay": 1000,
      "perRequest": 10,
      "countryCode": "PL"
    },
    "alerts": { "maxPerTick": 3, "lookbackHours": 48 }
  },
  "metrics": {
    "eveningFromHour": 18,
    "weekly": { "weekday": 1, "hour": 8 }
  },
  "site": {
    "url": "https://happow.krasnoroda.workers.dev",
    "name": "Happow"
  },
  "legal": {
    "contactEmail": "krasnoroda@gmail.com",
    "termsVersion": "2026-11-05-draft",
    "operator": null,
    "address": null
  },
  "email": {
    "provider": "none",
    "from": null,
    "secret": "RESEND_API_KEY",
    "endpoint": "https://api.resend.com/emails"
  },
  "auth": {
    "emailDelivery": "manual",
    "providers": [],
    "codeRequestsPerHourPerClient": 10,
    "codeRequestsPerDayPerEmail": 20,
    "codeRequestRetentionDays": 7,
    "codeValidHours": 24,
    "userCacheSec": 300,
    "codeEmail": {
      "pl": {
        "subject": "Twój kod do Happow: {code}",
        "body": "Cześć!\n\nTwój kod logowania do Happow: {code}\n\nWpisz go w aplikacji albo otwórz ten link na telefonie, na którym używasz Happow:\n{link}\n\nKod i link działają przez {hours} godz. Jeśli to nie Ty prosisz o kod, zignoruj tę wiadomość.\n\nHappow"
      },
      "en": {
        "subject": "Your Happow code: {code}",
        "body": "Hi!\n\nYour Happow sign-in code: {code}\n\nType it into the app, or open this link on the phone where you use Happow:\n{link}\n\nThe code and the link work for {hours} hours. If you didn't ask for a code, ignore this email.\n\nHappow"
      }
    }
  }
}
