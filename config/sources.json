    {
      "id": "wroclaw-go",
      "name": "wroclaw.pl GO",
      "adapter": "crawler",
      "regionIds": ["wroclaw"],
      "schedule": "24h",
      "rateLimit": "12/m",
      "trustLevel": "crawled",
      "enabled": true,
      "maxCacheAgeHours": 72,
      "republishDescription": false,
      "republishImages": false,
      "termsNotes": "City portal events; no public API or feed (brief: ask ARAW for one). Event pages publish schema.org Event JSON-LD. Crawled page. Store facts only (title, time, place, price) and link back; no descriptions or images are republished. robots.txt is honoured; 1 request/s.",
      "options": {
        "startUrls": ["https://www.wroclaw.pl/go/"],
        "followPattern": "^https://www\\.wroclaw\\.pl/go/wydarzenia/[a-z0-9-]+/\\d+-",
        "maxFollow": 120,
        "llmFallback": false
      },
      "defaultCategories": ["other"],
      "categoryMap": {
        "muzyka": "music",
        "kino": "cinema",
        "teatr": "theatre",
        "dla-dzieci": "kids",
        "sport-i-rekreacja": "sport",
        "edukacja-i-rozwoj": "talk",
        "rozrywka": "happening"
      }
    },
    {
      "id": "nfm",
      "name": "Narodowe Forum Muzyki",
      "adapter": "crawler",
      "regionIds": ["wroclaw"],
      "schedule": "24h",
      "rateLimit": "12/m",
      "trustLevel": "crawled",
      "enabled": true,
      "secrets": ["ANTHROPIC_API_KEY"],
      "maxCacheAgeHours": 72,
      "republishDescription": false,
      "republishImages": false,
      "termsNotes": "Venue calendar without structured data: event pages go through LLM extraction (cached by content hash). Crawled page. Store facts only (title, time, place, price) and link back; no descriptions or images are republished. robots.txt is honoured; 1 request/s.",
      "options": {
        "startUrls": ["https://www.nfm.wroclaw.pl/component/nfmcalendar"],
        "followPattern": "/pl/component/nfmcalendar/event/\\d+$",
        "maxFollow": 25,
        "llmFallback": true
      },
      "defaultVenue": {
        "name": "Narodowe Forum Muzyki",
        "street": "plac Wolności 1",
        "postalCode": "50-071",
        "city": "Wrocław",
        "aliases": ["NFM"]
      },
      "defaultCategories": ["music"],
      "categoryMap": {}
    },
    {
      "id": "threads",
      "name": "Threads",
      "adapter": "threads",
      "regionIds": ["wroclaw"],
      "schedule": "120m",
      "rateLimit": "1/s",
      "trustLevel": "community",
      "enabled": false,
      "secrets": ["THREADS_ACCESS_TOKEN", "ANTHROPIC_API_KEY"],
      "maxCacheAgeHours": 48,
      "republishDescription": false,
      "republishImages": false,
      "termsNotes": "Threads API keyword search; needs the threads_keyword_search permission (Meta App Review), until then it only finds the token owner's own posts. Quota checked from config (queriesPer7Days). Only event facts and the post's link are stored: no author, no post text, no images. Off until App Review and a legal check of social sources.",
      "options": {
        "endpoint": "https://graph.threads.net/v1.0/keyword_search",
        "searchType": "RECENT",
        "limit": 25,
        "postLookbackHours": 72,
        "queriesPer7Days": 500,
        "keywords": {
          "wroclaw": [
            "wyprzedaż garażowa Wrocław",
            "pchli targ Wrocław",
            "koncert podwórkowy Wrocław",
            "potańcówka Wrocław",
            "happening Wrocław"
          ]
        }
      },
      "defaultCategories": ["happening"],
      "categoryMap": {}
    },
