      "adapter": "venue-probe",
      "regionIds": ["wroclaw"],
      "schedule": "24h",
      "rateLimit": "12/m",
      "trustLevel": "crawled",
      "enabled": true,
      "termsNotes": "Checks OSM venues' websites for an iCal feed, The Events Calendar's REST API or Event JSON-LD: at most five requests per site, robots.txt honoured, 5 s between requests. Finds go to the admin's candidate list; nothing is read from a site until an admin accepts it.",
      "options": {
        "horizonDays": 60
      }
