    {
      "id": "ebilet",
      "name": "eBilet",
      "adapter": "crawler",
      "regionIds": ["wroclaw"],
      "schedule": "24h",
      "rateLimit": "12/m",
      "trustLevel": "crawled",
      "enabled": true,
      "maxCacheAgeHours": 72,
      "republishDescription": false,
      "republishImages": false,
      "termsNotes": "Ticketing site; the city listing publishes schema.org Event JSON-LD (ItemList). Crawled page. Store facts only (title, time, place, price) and link back; no descriptions or images are republished. robots.txt is honoured; 1 request/s.",
      "options": {
        "startUrls": ["https://www.ebilet.pl/miasto/wroclaw"],
        "followPattern": "^https://www\\.ebilet\\.pl/[a-z0-9-]+/[a-z0-9-]+/[a-z0-9-]+$",
        "maxFollow": 40,
        "llmFallback": false,
        "summaryListing": true
      },
      "defaultCategories": ["other"],
      "categoryMap": {
        "muzyka": "music",
        "koncerty": "music",
        "teatr": "theatre",
        "kabaret": "theatre",
        "stand-up": "theatre",
