    {
      "id": "ticketmaster",
      "name": "Ticketmaster",
      "adapter": "ticketmaster",
      "regionIds": ["wroclaw"],
      "schedule": "60m",
      "rateLimit": "5/s",
      "trustLevel": "api",
      "enabled": true,
      "completeListing": true,
      "secrets": ["TICKETMASTER_API_KEY"],
      "maxCacheAgeHours": 24,
      "termsNotes": "Discovery API v2. Free key: 5,000 calls/day, 5 req/s; deep paging capped at 1,000 results (size × page). Must link to the Ticketmaster event page for purchase and keep attribution; do not cache data beyond its freshness.",
      "options": {
        "endpoint": "https://app.ticketmaster.com/discovery/v2/events.json",
        "pageSize": 200,
        "maxPages": 5,
        "locale": "*"
      },
      "defaultCategories": ["other"],
      "categoryMap": {
        "music": "music",
        "sports": "sport",
        "arts & theatre": "theatre",
