# Copy to .env (never commit .env). All values are optional for local UI work:
# without Supabase the web app falls back to the bundled seed events.

# --- Database (scripts/migrate.ts, scripts/seed.ts, pnpm ingest, DB tests) ---
# Local:    postgres://postgres:postgres@localhost:5432/happow
# Supabase: Project Settings -> Database -> Connection string (session pooler)
DATABASE_URL=

# --- Web app (apps/web, read at build time; anon key is public by design) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional override of config/app.json "defaultRegion"
VITE_REGION_ID=

# --- Ingestion (pnpm ingest; GitHub Secrets of the same names for the Ingest workflow) ---
# A source is skipped while any of its secrets (config/sources.json "secrets") is empty.
# Ticketmaster Discovery API key: https://developer.ticketmaster.com (My Apps -> Consumer Key)
TICKETMASTER_API_KEY=
# Meetup OAuth client with a signing key (JWT bearer flow). API access requires Meetup Pro.
MEETUP_CLIENT_KEY=
MEETUP_MEMBER_ID=
MEETUP_SIGNING_KEY_ID=
# RSA private key PEM; literal "\n" line breaks are accepted
MEETUP_PRIVATE_KEY=
# Claude API key (https://console.anthropic.com): LLM extraction for crawled pages and the
# add-event autofill when a page has no schema.org data. Empty = JSON-LD only.
ANTHROPIC_API_KEY=

# --- Server API (/api: Cloudflare Worker; `pnpm dev` serves it from this file) ---
# In production set these in the Worker -> Settings -> Variables and Secrets.
# Same project URL as VITE_SUPABASE_URL
SUPABASE_URL=
# Supabase -> Project Settings -> API -> service_role key. Server only: never prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=
# Any long random string (e.g. `openssl rand -hex 32`); hashes device ids and IPs for rate limits.
SUBMITTER_SALT=
# openrouteservice key (account.heigit.org, free Standard plan) for in-app walking routes.
# Empty = a direct line to the venue; the Google Maps button does not need it.
ORS_API_KEY=
